<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>create_kr240_motion_primitives</name>
  <version>0.0.0</version>
  <description>File needed to run CREATE's KR240 using ros2_control.</description>
  <author>Ardeshir Talaei</author>
  <maintainer email="ardeshir.talaei@gmail.com">Ardeshir Talaei</maintainer>
  <license>Apache2</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ros2launch</test_depend>

  <depend>controller_manager</depend>
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>

  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>kuka_resources</exec_depend>
  <exec_depend>kuka_rsi_hw_interface</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tinyxml_vendor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
