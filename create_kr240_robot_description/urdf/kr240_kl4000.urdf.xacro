<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr240_kl4000">
    <xacro:arg name="prefix" default="" />

    <xacro:include filename="$(find create_kr240_robot_description)/urdf/kr240_r3330_macro.xacro" />
    <xacro:include filename="$(find create_kr240_robot_description)/urdf/kl4000_macro.xacro" />

    <xacro:kuka_kr240_r3330_robot prefix="${prefix}"/>
    <xacro:kuka_kl4000_rail prefix="${prefix}"/>

    <joint name="${prefix}carriage-robot" type="fixed">
      <child link="${prefix}base"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <parent link="${prefix}mount"/>
    </joint>
</robot>
