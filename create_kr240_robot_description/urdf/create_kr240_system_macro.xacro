<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="create_kr240_system">
  <xacro:macro name="create_kr240_system" params="prefix">

    <xacro:include filename="$(find create_kr240_robot_description)/urdf/kr240_r3330_macro.xacro" />
    <xacro:include filename="$(find create_kr240_robot_description)/urdf/kl4000_macro.xacro" />

    <xacro:kuka_kr240_r3330_robot prefix="${prefix}"/>
    <xacro:kuka_kl4000_rail prefix="${prefix}" ext_axis_name="e1"/>

    <joint name="$mount-robot" type="fixed">
      <child link="base_link"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <parent link="mount"/>
    </joint>

  </xacro:macro>
</robot>
